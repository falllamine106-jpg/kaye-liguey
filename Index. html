      <button
        class="btn btn-primary"
        id="saveProfileBtn"
        type="button">
        Enregistrer
      </button>

    </div>


    ${
      currentProfile?.role === "company"
      ?
      `
      <div class="card">

        <h3>🏢 Espace entreprise</h3>

        <p class="muted">
          Publiez vos offres et consultez
          les candidatures reçues.
        </p>

        <br>

        <button
          class="btn btn-primary"
          id="companyDashboardBtn"
          type="button">
          Tableau de bord entreprise
        </button>

      </div>
      `
      :
      `
      <div class="card">

        <h3>👤 Espace candidat</h3>

        <p class="muted">
          Consultez vos candidatures et
          vos offres favorites.
        </p>

        <br>

        <button
          class="btn btn-primary"
          id="candidateDashboardBtn"
          type="button">
          Mes candidatures
        </button>

      </div>
      `
    }

    ${
      currentProfile?.role === "admin"
      ?
      `
      <div class="card">

        <h3>👑 Administration</h3>

        <button
          class="btn btn-dark"
          id="adminDashboardBtn"
          type="button">
          Ouvrir l'administration
        </button>

      </div>
      `
      :
      ""
    }

  `;


  $("saveProfileBtn")
    ?.addEventListener(
      "click",
      saveProfile
    );


  $("companyDashboardBtn")
    ?.addEventListener(
      "click",
      ()=>navigate("applicationsPage")
    );


  $("candidateDashboardBtn")
    ?.addEventListener(
      "click",
      ()=>navigate("applicationsPage")
    );


  $("adminDashboardBtn")
    ?.addEventListener(
      "click",
      ()=>navigate("adminPage")
    );

}


async function saveProfile(){

  if(!currentUser) return;

  const name =
    $("profileName").value.trim();

  const phone =
    $("profilePhone").value.trim();

  const city =
    $("profileCity").value.trim();

  const bio =
    $("profileBio").value.trim();

  try{

    await updateDoc(
      doc(
        db,
        "users",
        currentUser.uid
      ),
      {
        name,
        phone,
        city,
        bio
      }
    );

    await loadCurrentProfile();

    alert("Profil enregistré.");

    renderProfile();

  }catch(error){

    console.error(error);

    alert(
      "Erreur lors de l'enregistrement : " +
      error.message
    );

  }

}


/* =========================================================
   ADMIN
========================================================= */

async function loadAdmin(){

  if(currentProfile?.role !== "admin"){

    alert("Accès administrateur refusé.");

    navigate("homePage");

    return;
  }

  try{

    const users =
      await getDocs(
        collection(db,"users")
      );

    const offers =
      await getDocs(
        collection(db,"offers")
      );

    const applications =
      await getDocs(
        collection(db,"applications")
      );

    $("adminUsersCount").textContent =
      users.size;

    $("adminOffersCount").textContent =
      offers.size;

    $("adminApplicationsCount").textContent =
      applications.size;


    $("adminUsers").innerHTML =
      users.docs.map(item=>{

        const data = item.data();

        return `
          <div class="card">

            <strong>
              ${escapeHTML(
                data.name || "Utilisateur"
              )}
            </strong>

            <p class="muted">
              ${escapeHTML(
                data.email || ""
              )}
            </p>

            <span class="badge">
              ${escapeHTML(
                data.role || "candidate"
              )}
            </span>

          </div>
        `;

      }).join("");


    $("adminOffers").innerHTML =
      offers.docs.map(item=>{

        const data = item.data();

        return `
          <div class="card">

            <h3>
              ${escapeHTML(
                data.title || "Offre"
              )}
            </h3>

            <p class="muted">
              ${escapeHTML(
                data.companyName || ""
              )}
            </p>

          </div>
        `;

      }).join("");

  }catch(error){

    console.error(error);

    alert(
      "Erreur administration : " +
      error.message
    );

  }

}


/* =========================================================
   INITIALISATION
========================================================= */

loadOffers();

navigate("homePage");

</script>

