</section>


<!-- PUBLIER -->
<section id="publishPage" class="page">

  <h1 class="section-title">➕ Publier une offre</h1>

  <div id="publishLoginMessage" class="alert alert-error hidden">
    Vous devez être connecté en tant qu'entreprise.
  </div>

  <div class="card form">

    <div class="form-group">
      <label for="offerTitle">Titre du poste</label>
      <input id="offerTitle" placeholder="Ex : Développeur Web">
    </div>

    <div class="form-group">
      <label for="offerDescription">Description</label>
      <textarea id="offerDescription" placeholder="Décrivez le poste..."></textarea>
    </div>

    <div class="form-group">
      <label for="offerCategory">Catégorie</label>
      <select id="offerCategory">
        <option value="">Choisir</option>
        <option>Informatique</option>
        <option>Gestion</option>
        <option>Marketing</option>
        <option>BTP</option>
        <option>Transport</option>
        <option>Commerce</option>
        <option>Autre</option>
      </select>
    </div>

    <div class="form-group">
      <label for="offerCity">Ville</label>
      <input id="offerCity" placeholder="Dakar">
    </div>

    <div class="form-group">
      <label for="offerRegion">Région</label>
      <input id="offerRegion" placeholder="Dakar">
    </div>

    <div class="form-group">
      <label for="offerContract">Contrat</label>
      <select id="offerContract">
