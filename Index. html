async function loadMessages(){

  const box = $("messagesList");

  if(!currentUser){

    box.innerHTML =
      `<div class="empty">Connectez-vous.</div>`;

    return;
  }

  try{

    const sentQuery =
      query(
        collection(db,"messages"),
        where(
          "senderId",
          "==",
          currentUser.uid
        )
      );

    const receivedQuery =
      query(
        collection(db,"messages"),
        where(
          "receiverId",
          "==",
          currentUser.uid
        )
      );

    const [sent,received] =
      await Promise.all([
        getDocs(sentQuery),
        getDocs(receivedQuery)
      ]);

    const messages = [];

    sent.docs.forEach(item=>{
      messages.push({
        id:item.id,
        ...item.data()
      });
    });

    received.docs.forEach(item=>{
      messages.push({
        id:item.id,
        ...item.data()
      });
    });

    if(!messages.length){

      box.innerHTML =
        `<div class="empty">
          Aucun message.
        </div>`;

      return;
    }

    box.innerHTML =
      messages.map(message=>{

        return `
          <div class="card">

            <p>
              <strong>
                ${escapeHTML(
                  message.senderId === currentUser.uid
                  ? "Vous"
                  : "Message reçu"
                )}
              </strong>
            </p>

            <p>
              ${escapeHTML(message.text)}
            </p>

          </div>
        `;

      }).join("");

  }catch(error){

    console.error(error);

    box.innerHTML =
      `<div class="alert alert-error">
        Impossible de charger les messages.
      </div>`;

  }

}


