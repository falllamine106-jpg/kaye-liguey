async function loadOffers(){

  try{

    const q =
      query(
        collection(db,"offers"),
        orderBy("createdAt","desc"),
        limit(100)
      );

    const snapshot = await getDocs(q);

    allOffers =
      snapshot.docs.map(d=>({
        id:d.id,
        ...d.data()
      }));

  }catch(error){

    console.error(error);

    /*
      Si la base contient peu de données et que
      l'index n'existe pas encore, on essaie sans orderBy.
    */

    try{

      const snapshot =
        await getDocs(
          collection(db,"offers")
        );

      allOffers =
        snapshot.docs.map(d=>({
          id:d.id,
          ...d.data()
        }));

    }catch(error2){

      console.error(error2);

      allOffers = [];
    }
  }

  renderJobs(allOffers);
}


