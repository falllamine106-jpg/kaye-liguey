    const snapshot =
      await getDocs(q);

    if(!snapshot.empty){

      for(const item of snapshot.docs){

        await deleteDoc(
          doc(db,"favorites",item.id)
        );

      }

      alert("Retiré des favoris.");

    }else{

      await addDoc(
        collection(db,"favorites"),
