  </div>

</section>


<!-- APPLICATIONS -->
<section id="applicationsPage" class="page">

  <h1 class="section-title">📝 Mes candidatures</h1>
  <div id="applicationsList"></div>

</section>


<!-- FAVORIS -->
<section id="favoritesPage" class="page">

  <h1 class="section-title">⭐ Mes favoris</h1>
  <div id="favoritesList" class="grid"></div>

</section>


<!-- MESSAGES -->
<section id="messagesPage" class="page">

