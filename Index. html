<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KAYE LIGUEY</title>

<style>
:root{
  --navy:#0A1E3F;
  --green:#00C853;
  --green2:#00A844;
  --bg:#f4f7fa;
  --white:#fff;
  --text:#172033;
  --muted:#687386;
  --border:#e2e7ef;
  --danger:#e53935;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:var(--bg);
  color:var(--text);
}

button,input,select,textarea{
  font:inherit;
}

button{
  cursor:pointer;
}

.hidden{
  display:none!important;
}

header{
  background:var(--navy);
  color:white;
  position:sticky;
  top:0;
  z-index:100;
}

.header-inner{
  max-width:1200px;
  margin:auto;
  padding:15px 20px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
}

.logo{
  font-size:23px;
  font-weight:800;
  color:white;
}

.logo span{
  color:var(--green);
}

.header-actions{
  display:flex;
  align-items:center;
  gap:8px;
}

.icon-btn{
  background:transparent;
  border:1px solid rgba(255,255,255,.2);
  color:white;
  border-radius:10px;
  padding:10px 13px;
}

main{
  max-width:1200px;
  margin:auto;
  padding:25px 18px 100px;
}

.page{
  display:none;
}

.page.active{
  display:block;
}

.hero{
  background:linear-gradient(135deg,var(--navy),#173c72);
  color:white;
  border-radius:22px;
  padding:45px 30px;
  margin-bottom:25px;
}

.hero h1{
  font-size:clamp(30px,5vw,52px);
  margin-bottom:12px;
}

.hero p{
  font-size:18px;
  color:#e6edf7;
  max-width:700px;
  line-height:1.6;
}

.hero-actions{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-top:25px;
}

.btn{
  border:none;
  border-radius:10px;
  padding:12px 17px;
  font-weight:700;
  min-height:44px;
}

.btn-primary{
  background:var(--green);
  color:#062d18;
}

.btn-primary:hover{
  background:var(--green2);
  color:white;
}

.btn-dark{
  background:var(--navy);
  color:white;
}

.btn-light{
  background:white;
  color:var(--navy);
  border:1px solid var(--border);
}

.btn-danger{
  background:var(--danger);
  color:white;
}

.btn-small{
  padding:9px 12px;
  min-height:38px;
  font-size:14px;
}

.search-box{
  background:white;
  padding:15px;
  border-radius:16px;
  border:1px solid var(--border);
  display:flex;
  gap:10px;
  margin-bottom:25px;
}

.search-box input{
  flex:1;
}

input,select,textarea{
  width:100%;
  border:1px solid var(--border);
  border-radius:10px;
  padding:12px;
  background:white;
  outline:none;
}

input:focus,select:focus,textarea:focus{
  border-color:var(--green);
}

textarea{
  min-height:120px;
  resize:vertical;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(270px,1fr));
  gap:18px;
}

.card{
  background:white;
  border:1px solid var(--border);
  border-radius:16px;
  padding:20px;
  margin-bottom:18px;
}

.card h3{
  color:var(--navy);
  margin-bottom:8px;
}

.muted{
  color:var(--muted);
}

.job-card{
  display:flex;
  flex-direction:column;
  gap:12px;
}

.job-top{
  display:flex;
  justify-content:space-between;
  gap:10px;
}

.badge{
  display:inline-flex;
  padding:5px 9px;
  border-radius:999px;
  background:#e9f8ef;
  color:#087b39;
  font-size:12px;
  font-weight:700;
}

.badge-blue{
  background:#eaf1ff;
  color:#275db8;
}

.badge-red{
  background:#ffebeb;
  color:#b91c1c;
}

.actions{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin-top:8px;
}

.section-title{
  margin:25px 0 15px;
}

.form{
  max-width:750px;
}

.form-group{
  margin-bottom:15px;
}

.form-group label{
  display:block;
  font-weight:700;
  margin-bottom:6px;
}

.nav{
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  background:white;
  border-top:1px solid var(--border);
  z-index:200;
}

.nav-inner{
  max-width:900px;
  margin:auto;
  display:flex;
  justify-content:space-around;
  overflow-x:auto;
}

.nav button{
  border:0;
  background:white;
  color:var(--muted);
  padding:13px 12px;
  min-width:75px;
  font-size:12px;
}

.nav button.active{
  color:var(--green2);
  font-weight:800;
}

.modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.55);
  display:flex;
  align-items:center;
  justify-content:center;
  padding:15px;
  z-index:500;
}

.modal-box{
  width:min(500px,100%);
  max-height:90vh;
  overflow:auto;
  background:white;
  border-radius:18px;
  padding:25px;
}

.modal-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:20px;
}

.close{
  border:0;
  background:#eee;
  border-radius:8px;
  width:40px;
  height:40px;
}

.role-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin-bottom:18px;
}

.role-btn{
  border:2px solid var(--border);
  background:white;
  border-radius:12px;
  padding:16px;
  font-weight:700;
}

.role-btn.selected{
  border-color:var(--green);
  background:#edfff4;
}

.stat-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
  gap:12px;
}

.stat{
  background:white;
  border:1px solid var(--border);
  border-radius:15px;
  padding:20px;
}

.stat strong{
  display:block;
  font-size:28px;
  color:var(--navy);
  margin-top:5px;
}

.alert{
  padding:13px;
  border-radius:10px;
  margin-bottom:15px;
}

.alert-success{
  background:#e8f8ee;
  color:#087b39;
}

.alert-error{
  background:#ffeded;
  color:#a61919;
}

.empty{
  text-align:center;
  padding:35px;
  color:var(--muted);
}

.profile-head{
  display:flex;
  align-items:center;
  gap:15px;
}

.avatar{
  width:65px;
  height:65px;
  border-radius:50%;
  background:var(--navy);
  color:white;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:24px;
  font-weight:800;
}

@media(max-width:600px){
  .hero{
    padding:30px 20px;
  }

  .search-box{
    flex-direction:column;
  }

  .role-grid{
    grid-template-columns:1fr;
  }

  .header-inner{
    padding:12px;
  }

  main{
    padding-left:12px;
    padding-right:12px;
  }
}
</style>
</head>

<body>

<header>
  <div class="header-inner">
    <div class="logo">KAYE <span>LIGUEY</span></div>

    <div class="header-actions">
      <button class="icon-btn" id="notificationBtn" type="button">🔔</button>
      <button class="icon-btn" id="authBtn" type="button">Connexion</button>
    </div>
  </div>
</header>

<main>

<!-- ACCUEIL -->
<section id="homePage" class="page active">

  <div class="hero">
    <h1>Trouvez votre emploi.</h1>
    <p>
      Trouvez votre emploi, construisez votre avenir.
      KAYE LIGUEY connecte les chercheurs d'emploi et les entreprises.
    </p>

    <div class="hero-actions">
      <button class="btn btn-primary" id="findJobBtn" type="button">
        🔎 Rechercher un emploi
      </button>

      <button class="btn btn-light" id="publishHeroBtn" type="button">
        ➕ Publier une offre
      </button>
    </div>
  </div>

  <div class="search-box">
    <input id="homeSearch" type="search" placeholder="Rechercher un emploi...">
    <button class="btn btn-primary" id="searchBtn" type="button">Rechercher</button>
  </div>

  <h2 class="section-title">💼 Offres récentes</h2>
  <div id="homeJobs" class="grid"></div>

</section>


<!-- JOBS -->
<section id="jobsPage" class="page">

  <h1 class="section-title">💼 Offres d'emploi</h1>

  <div class="search-box">
    <input id="jobsSearch" type="search" placeholder="Métier, compétence...">

    <select id="jobsCity">
      <option value="">Toutes les villes</option>
