async function applyToJob(job){

  if(!currentUser){

    openAuth();

    showMessage(
      "Connectez-vous pour postuler.",
      "error"
    );

    return;
  }

  if(currentProfile?.role !== "candidate"){

    alert(
      "Seul un candidat peut postuler à une offre."
    );

    return;
  }

  try{

    const existingQuery =
      query(
        collection(db,"applications"),
        where("candidateId","==",currentUser.uid),
        where("offerId","==",job.id)
      );

    const existing =
      await getDocs(existingQuery);

    if(!existing.empty){

      alert("Vous avez déjà postulé à cette offre.");

      return;
    }

    await addDoc(
      collection(db,"applications"),
      {
        candidateId:currentUser.uid,
        candidateName:currentProfile.name || "",
        candidateEmail:currentUser.email || "",
        offerId:job.id,
        offerTitle:job.title || "",
        companyId:job.companyId || "",
        companyName:job.companyName || "",
        status:"En attente",
        createdAt:serverTimestamp()
      }
    );

    await addDoc(
      collection(db,"notifications"),
      {
        userId:currentUser.uid,
        title:"Candidature envoyée",
        message:`Votre candidature pour ${job.title} a été envoyée.`,
        read:false,
        createdAt:serverTimestamp()
      }
    );

    hide("offerModal");

    alert("Votre candidature a été envoyée avec succès.");

    navigate("applicationsPage");

  }catch(error){

    console.error(error);

    alert(
      "Impossible d'envoyer la candidature : " +
      error.message
    );

  }

}


