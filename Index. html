  <div id="messagesList"></div>

  <div class="card">
    <h3>Envoyer un message</h3>

    <div class="form-group">
      <label>Destinataire</label>
      <input id="messageReceiver" placeholder="ID utilisateur">
    </div>

    <div class="form-group">
      <label>Message</label>
      <textarea id="messageText" placeholder="Votre message..."></textarea>
    </div>

    <button class="btn btn-primary" id="sendMessageBtn" type="button">
      Envoyer
    </button>
  </div>

</section>


<!-- NOTIFICATIONS -->
<section id="notificationsPage" class="page">

  <h1 class="section-title">🔔 Notifications</h1>
  <div id="notificationsList"></div>

</section>


<!-- PROFIL -->
<section id="profilePage" class="page">

  <h1 class="section-title">👤 Mon profil</h1>

  <div id="profileContent"></div>

</section>


<!-- ADMIN -->
<section id="adminPage" class="page">

  <h1 class="section-title">👑 Administration</h1>

  <div class="stat-grid">
    <div class="stat">
      Utilisateurs
      <strong id="adminUsersCount">0</strong>
    </div>

    <div class="stat">
      Offres
      <strong id="adminOffersCount">0</strong>
    </div>

    <div class="stat">
      Candidatures
      <strong id="adminApplicationsCount">0</strong>
    </div>
  </div>

  <div class="card">
    <h3>Gestion des utilisateurs</h3>
    <div id="adminUsers"></div>
  </div>

  <div class="card">
    <h3>Gestion des offres</h3>
    <div id="adminOffers"></div>
  </div>

</section>

</main>


<!-- NAVIGATION -->
<nav class="nav">
  <div class="nav-inner">

    <button type="button" data-page="homePage">🏠<br>Accueil</button>

    <button type="button" data-page="jobsPage">💼<br>Jobs</button>

    <button type="button" data-page="publishPage">➕<br>Publier</button>

    <button type="button" data-page="applicationsPage">📝<br>Candidatures</button>

    <button type="button" data-page="favoritesPage">⭐<br>Favoris</button>

    <button type="button" data-page="messagesPage">💬<br>Messages</button>

    <button type="button" data-page="profilePage">👤<br>Profil</button>

  </div>
</nav>


<!-- AUTH MODAL -->
<div id="authModal" class="modal hidden">

  <div class="modal-box">

    <div class="modal-header">
      <h2 id="authTitle">Connexion</h2>
      <button class="close" id="closeAuthBtn" type="button">✕</button>
    </div>

    <div id="authMessage"></div>

    <div id="loginForm">

      <div class="form-group">
        <label>Email</label>
        <input id="loginEmail" type="email" placeholder="email@example.com">
      </div>

      <div class="form-group">
        <label>Mot de passe</label>
        <input id="loginPassword" type="password" placeholder="Mot de passe">
      </div>

      <button class="btn btn-primary" id="loginBtn" type="button">
        Se connecter
      </button>

      <br><br>

      <button class="btn btn-light" id="showRegisterBtn" type="button">
        Créer un compte
      </button>

      <br><br>

      <button class="btn btn-light" id="forgotPasswordBtn" type="button">
        Mot de passe oublié ?
      </button>

    </div>


    <div id="registerForm" class="hidden">

      <h3>Créer un compte</h3>

      <br>

      <div class="role-grid">

        <button class="role-btn selected" data-role="candidate" type="button">
          👤 Candidat
        </button>

        <button class="role-btn" data-role="company" type="button">
          🏢 Entreprise
        </button>

      </div>

      <div class="form-group">
        <label>Nom / Nom de l'entreprise</label>
        <input id="registerName" placeholder="Votre nom">
      </div>

      <div class="form-group">
        <label>Email</label>
        <input id="registerEmail" type="email" placeholder="email@example.com">
      </div>

      <div class="form-group">
        <label>Mot de passe</label>
        <input id="registerPassword" type="password" placeholder="Minimum 6 caractères">
      </div>

      <div class="form-group">
        <label>Téléphone</label>
        <input id="registerPhone" type="tel" placeholder="+221...">
      </div>

      <button class="btn btn-primary" id="registerBtn" type="button">
        Créer mon compte
      </button>

      <br><br>

      <button class="btn btn-light" id="showLoginBtn" type="button">
        J'ai déjà un compte
      </button>

    </div>

  </div>
</div>


<!-- DETAILS OFFER -->
<div id="offerModal" class="modal hidden">

  <div class="modal-box">

    <div class="modal-header">
      <h2>Détails de l'offre</h2>
      <button class="close" id="closeOfferBtn" type="button">✕</button>
    </div>

    <div id="offerDetails"></div>

  </div>

</div>


<script type="module">

/* =========================================================
   FIREBASE
========================================================= */

import { initializeApp }
from "https://www.gstatic.com/firebasejs/12.19.0/firebase-app.js";

import {
  getAuth,
  createUserWithEmailAndPassword,
  signInWithEmailAndPassword,
  sendPasswordResetEmail,
  signOut,
  onAuthStateChanged
}
from "https://www.gstatic.com/firebasejs/12.19.0/firebase-auth.js";

import {
  getFirestore,
  collection,
  addDoc,
  setDoc,
  getDoc,
  getDocs,
  doc,
  query,
  where,
  orderBy,
  limit,
  updateDoc,
  deleteDoc,
  serverTimestamp
}
from "https://www.gstatic.com/firebasejs/12.19.0/firebase-firestore.js";


const firebaseConfig = {
  apiKey: "AIzaSyDEXy-VTC7nQ5KCe9x4s70j1tWtLrBvtl0",
  authDomain: "kaye-liguey.firebaseapp.com",
  projectId: "kaye-liguey",
  storageBucket: "kaye-liguey.firebasestorage.app",
  messagingSenderId: "6308207019",
  appId: "1:6308207019:web:00c6c29ac26bfff7cb1aee",
  measurementId: "G-E8YSXJDLJD"
};

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);


/* =========================================================
   ÉTAT
========================================================= */

let currentUser = null;
let currentProfile = null;
let selectedRole = "candidate";
let allOffers = [];
let currentOffer = null;


/* =========================================================
   OUTILS
========================================================= */

function $(id){
  return document.getElementById(id);
}

function show(id){
  $(id)?.classList.remove("hidden");
}

function hide(id){
  $(id)?.classList.add("hidden");
}

function escapeHTML(value){
  return String(value ?? "")
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");
}

function showMessage(text,type="success"){
  const box = $("authMessage");

  if(!box) return;

  box.innerHTML =
    `<div class="alert ${type === "error" ? "alert-error" : "alert-success"}">
      ${escapeHTML(text)}
    </div>`;
}

function openAuth(){
  show("authModal");
}

function closeAuth(){
  hide("authModal");
}

function navigate(pageId){

  document.querySelectorAll(".page").forEach(page=>{
    page.classList.remove("active");
  });

  const page = $(pageId);

  if(page){
    page.classList.add("active");
  }

  document.querySelectorAll(".nav button").forEach(button=>{
    button.classList.toggle(
      "active",
      button.dataset.page === pageId
    );
  });

  if(pageId === "jobsPage"){
    renderJobs(allOffers);
  }

  if(pageId === "applicationsPage"){
    loadApplications();
  }

  if(pageId === "favoritesPage"){
    loadFavorites();
  }

  if(pageId === "messagesPage"){
    loadMessages();
  }

  if(pageId === "notificationsPage"){
    loadNotifications();
  }

  if(pageId === "profilePage"){
    renderProfile();
  }

  if(pageId === "adminPage"){
    loadAdmin();
  }

  window.scrollTo({
    top:0,
    behavior:"smooth"
  });
}


/* =========================================================
   NAVIGATION
========================================================= */

document.querySelectorAll(".nav button").forEach(button=>{

  button.addEventListener("click",()=>{

    const page = button.dataset.page;

    if(page === "publishPage" &&
       (!currentUser || currentProfile?.role !== "company")){

      openAuth();
      showMessage(
        "Connectez-vous avec un compte entreprise pour publier une offre.",
        "error"
      );
      return;
    }

    if(
      ["applicationsPage","favoritesPage","messagesPage","notificationsPage","profilePage"]
      .includes(page)
      && !currentUser
    ){
      openAuth();
      showMessage("Connectez-vous pour accéder à cette section.","error");
      return;
    }

    if(page === "adminPage" && currentProfile?.role !== "admin"){
      alert("Accès réservé à l'administrateur.");
      return;
    }

    navigate(page);
  });

});


/* =========================================================
   AUTH
========================================================= */

$("authBtn").addEventListener("click",()=>{

  if(currentUser){

    const answer = confirm(
      "Voulez-vous vraiment vous déconnecter ?"
    );

    if(answer){
      signOut(auth)
        .then(()=>{
          alert("Vous êtes déconnecté.");
          navigate("homePage");
        })
        .catch(error=>{
          alert(error.message);
        });
    }

  }else{
    openAuth();
  }

});


$("closeAuthBtn").addEventListener("click",closeAuth);

$("showRegisterBtn").addEventListener("click",()=>{

  hide("loginForm");
  show("registerForm");

  $("authTitle").textContent = "Créer un compte";
  $("authMessage").innerHTML = "";

});


$("showLoginBtn").addEventListener("click",()=>{

  hide("registerForm");
  show("loginForm");

  $("authTitle").textContent = "Connexion";
  $("authMessage").innerHTML = "";

});


/* =========================================================
   CHOIX DU ROLE
========================================================= */

document.querySelectorAll(".role-btn").forEach(button=>{

  button.addEventListener("click",()=>{

    document.querySelectorAll(".role-btn")
      .forEach(b=>b.classList.remove("selected"));

    button.classList.add("selected");

    selectedRole = button.dataset.role;

  });

});


/* =========================================================
   INSCRIPTION
========================================================= */

$("registerBtn").addEventListener("click",async()=>{

  const name = $("registerName").value.trim();
  const email = $("registerEmail").value.trim();
  const password = $("registerPassword").value;
  const phone = $("registerPhone").value.trim();

  if(!name || !email || !password){

    showMessage(
      "Remplissez le nom, l'email et le mot de passe.",
      "error"
    );

    return;
  }

  if(password.length < 6){

    showMessage(
      "Le mot de passe doit contenir au moins 6 caractères.",
      "error"
    );

    return;
  }

  try{

    const credential =
      await createUserWithEmailAndPassword(
        auth,
        email,
        password
      );

    const user = credential.user;

    await setDoc(
      doc(db,"users",user.uid),
      {
        uid:user.uid,
        name:name,
        email:email,
        phone:phone,
        role:selectedRole,
        createdAt:serverTimestamp()
      }
    );

    currentUser = user;

    await loadCurrentProfile();

    closeAuth();

    alert("Compte créé avec succès.");

    renderProfile();

    navigate("profilePage");

  }catch(error){

    console.error(error);

    let message = error.message;

    if(error.code === "auth/email-already-in-use"){
      message = "Cette adresse email est déjà utilisée.";
    }

    if(error.code === "auth/invalid-email"){
      message = "Adresse email invalide.";
    }

    showMessage(message,"error");
  }

});


